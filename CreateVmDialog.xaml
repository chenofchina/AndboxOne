<Window x:Class="AndboxOne.CreateVmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建虚拟机" Width="440" SizeToContent="Height"
        Background="{StaticResource Bg0}" FontFamily="{StaticResource MonoFont}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="SingleBorderWindow">
    <StackPanel Margin="16">
        <TextBlock Text="▣ 创建离线虚拟机" Style="{StaticResource SectionHeader}" FontSize="14"/>

        <TextBlock Text="AVD 名称（字母/数字/._- ，≤64 字符）" Style="{StaticResource DimText}" Margin="0,4,0,2"/>
        <TextBox x:Name="NameBox" Padding="6,5"/>

        <TextBlock Text="设备预设" Style="{StaticResource DimText}" Margin="0,10,0,2"/>
        <ComboBox x:Name="PresetCombo" MinHeight="30"/>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="CPU 核心" Style="{StaticResource DimText}" Margin="0,0,0,2"/>
                <ComboBox x:Name="CpuCombo" MinHeight="30"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="内存" Style="{StaticResource DimText}" Margin="0,0,0,2"/>
                <ComboBox x:Name="RamCombo" MinHeight="30"/>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="PreviewText" Style="{StaticResource DimText}" Margin="0,10,0,0" Text="—"/>

        <WrapPanel Margin="0,14,0,0" HorizontalAlignment="Right">
            <Button Content="取消" Padding="14,6" Click="Cancel_Click"/>
            <Button Content="✔ 创建" Padding="14,6" Margin="8,0,0,0" Click="Create_Click"/>
        </WrapPanel>
    </StackPanel>
</Window>
